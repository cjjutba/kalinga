# Copy to .env.local. Never commit .env.local. This repository is public.

# Postgres on Neon. Locally use the dev branch, production uses main through
# the Vercel environment. Pooled connection string, sslmode=require.
DATABASE_URL=
# The same database without the -pooler host. Migrations, dumps and anything
# holding session state run over this one.
DATABASE_URL_UNPOOLED=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign in, optional. Set both and "Continue with Google" appears on the
# sign in and sign up screens. Create the credentials in Google Cloud console
# under APIs and services, Credentials, OAuth client ID, web application, and
# give it both redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://kalinga.cjjutba.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, production only. The sandbox and local development never send.
RESEND_API_KEY=

# Where privacy requests from /privacy/request are sent. Defaults to privacy@cjjutba.dev.
PRIVACY_INBOX=
# The From header for every email. Defaults to Kalinga <kalinga@cjjutba.dev>.
EMAIL_FROM=
